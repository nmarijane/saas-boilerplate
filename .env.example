# Database (omit for PGlite local dev)
# DATABASE_URL=postgresql://user:password@localhost:5432/boilerplate

# Better Auth. The secret has no default: generate one with `openssl rand -hex 32` (32 characters
# at least). Required in production; in development, unset, Better Auth uses a throwaway one.
# BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3088

# OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# The prices of the catalog: `npm run stripe:catalog` creates them in test mode and prints these lines
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=
STRIPE_PRICE_CREDITS_1000=
STRIPE_PRICE_CREDITS_5000=
# The customer portal the app opens, for the payment method and the invoices only (`npm run stripe:catalog` prints it)
STRIPE_PORTAL_CONFIGURATION_ID=
# The currency of the plans (default usd)
# BILLING_CURRENCY=usd
# Stripe Tax (VAT at checkout, off by default)
# STRIPE_TAX_ENABLED=false
# A free trial without a card: it ends in the free plan (default false: the card is asked at entry)
# BILLING_TRIAL_WITHOUT_CARD=false
# Workspaces on the free plan that one person may own (default 1)
# MAX_FREE_WORKSPACES=1

# SMTP (email)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@localhost

# AI assistant (optional): the assistant is on as soon as one provider key is set. With none
# set, the AI page says it is not configured (docs/SETUP.md, "Optional: AI assistant").
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GROQ_API_KEY=
# Wired as a provider, but no model of the list runs on it yet (docs/SETUP.md)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AI_DEFAULT_MODEL=gpt-4o-mini
# The monthly credits of a workspace come from its plan (`limits.aiCredits` in src/features/billing/plans.ts)

# Storage
STORAGE_ADAPTER=local
UPLOAD_MAX_SIZE=10000000

# S3 (optional, if STORAGE_ADAPTER=s3)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3088

# Where the address of the client comes from, for the rate limits (docs/SETUP.md, "Behind a proxy"):
# `vercel`, or the number of reverse proxies in front of the app. Unset, no header is believed and every
# request shares one limit: fine in development, not in production.
# TRUST_PROXY=1

# Rate Limiting (adapter: memory | redis | upstash)
RATE_LIMIT_ADAPTER=memory
# REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Audit Log
AUDIT_LOG_RETENTION_DAYS=90

# Sentry (optional)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Inngest (optional, auto-detected in dev)
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
