{
  "name": "@ai-chambers/design-system",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./dist/src/index.js",
    "./styles.css": "./src/styles/index.css"
  },
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && vite build",
    "dev": "vite --host 127.0.0.1",
    "test": "node --import tsx --test tests/model.test.ts",
    "test:browser": "node tests/browser.mjs",
    "verify:static": "node scripts/verify.mjs",
    "verify": "npm run tokens && npm run format:check && npm run typecheck && npm test && npm run verify:static && npm run build",
    "format": "prettier --write src examples tests scripts docs tokens contracts *.md *.json *.ts",
    "format:check": "prettier --check src examples tests scripts docs tokens contracts *.md *.json *.ts"
  },
  "dependencies": {
    "@patternfly/react-core": "6.7.0",
    "@patternfly/react-icons": "6.7.0",
    "@patternfly/react-table": "6.7.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "axe-core": "4.11.0",
    "playwright": "1.56.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
